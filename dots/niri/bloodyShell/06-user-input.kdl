// Personal input settings. Dots import preserves this file.
input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }

        repeat-delay 350
        repeat-rate 35
        track-layout "global"

        numlock
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"

        scroll-factor 1.0
    }

    touchpad {
        tap
        dwt

        natural-scroll
        middle-emulation

        accel-speed 0.2
        accel-profile "flat"

        scroll-factor horizontal=0.6 vertical=0.6
        scroll-method "two-finger"

        tap-button-map "left-right-middle"
        click-method "button-areas"

        disabled-on-external-mouse
    }

    // warp-mouse-to-focus
    // focus-follows-mouse

    workspace-auto-back-and-forth

    mod-key "Super"
}

cursor {
    xcursor-theme "Bibata Material Grey"
    xcursor-size 24
}
