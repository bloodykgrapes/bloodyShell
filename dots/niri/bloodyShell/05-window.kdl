// ─────────────────────────────────────────────────────────────────────────────
// 05 ─ Window Rules
// ─────────────────────────────────────────────────────────────────────────────
// Docs: https://niri-wm.github.io/niri/Configuration:-Window-Rules
//
// Window appearance, floating behavior and application-specific rules.
// ─────────────────────────────────────────────────────────────────────────────

// ──── GLOBAL ─────────────────────────────

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^(gamescope|steam_app_[0-9]+|dota2|lutris|net\.lutris\..*|heroic|com\.heroicgameslauncher\.hgl|org\.prismlauncher\.PrismLauncher|minecraft|wine|wine64)$"#

    geometry-corner-radius 0
    clip-to-geometry false
}

// ──── PER-APP ────────────────────────────

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"
}

window-rule {
    match title=r#"(?i)^picture.in.picture$"#

    open-floating true
    opacity 1.0

    default-floating-position x=32 y=32 relative-to="bottom-right"
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#

    open-floating true
    open-focused false

    default-floating-position x=10 y=10 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^xdg-desktop-portal-gtk$"# title="^(Open|Select|Save)\b"

    open-floating true
    open-focused true

    default-window-height { proportion 0.55; }
    default-column-width { proportion 0.45; }
}

window-rule {
    match app-id="karing"
    match app-id="org.telegram.desktop"

    default-column-width { proportion 0.33333; }
}
