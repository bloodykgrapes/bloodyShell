layout {
    background-color "transparent"
    
    gaps 10

    center-focused-column "never"

    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // default-column-height { }
    // preset-column-heights { }

    focus-ring {
        width 2

        active-color "#f5f5f7"
        inactive-color "#505050"
    }
    
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

animations {
    // slowdown 1.5

    window-open {
        duration-ms 250
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 250
        curve "ease-out-quad"
    }
}

prefer-no-csd

overview {
    backdrop-color "#141416"
}

blur {
    passes 3
    offset 3.3
    noise 0.02
    saturation 1.3
}
