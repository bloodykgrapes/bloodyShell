// ------------------------------------------------------------
// Login screen compositor
// Fullscreen SDDM session without window decorations or animations.
// ------------------------------------------------------------

hotkey-overlay { skip-at-startup; }
prefer-no-csd
layout {
    gaps 0
    focus-ring { off; }
    border { off; }
    shadow { off; }
}
animations { off; }
window-rule {
    open-fullscreen true
    draw-border-with-background false
}
