#!/usr/bin/env python3

import configparser
import json
from pathlib import Path
import shlex
import shutil


def sessions(directory=Path("/usr/share/wayland-sessions")):
    result = []
    for path in sorted(directory.glob("*.desktop")):
        parser = configparser.ConfigParser(interpolation=None, strict=False)
        try:
            parser.read(path)
            entry = parser["Desktop Entry"]
            if any(entry.get(key, "false").lower() == "true" for key in ("Hidden", "NoDisplay")):
                continue
            command = shlex.split(entry.get("Exec", ""))
            if not command or any("%" in arg for arg in command) or not shutil.which(command[0]):
                continue
            if entry.get("TryExec") and not shutil.which(entry["TryExec"]):
                continue
            result.append(dict(id=path.stem, name=entry.get("Name", path.stem), command=command,
                               desktop=entry.get("DesktopNames", path.stem).replace(";", ":").strip(":")))
        except (OSError, ValueError, KeyError, configparser.Error):
            continue
    if not any("niri" in item["desktop"].lower() for item in result) and shutil.which("niri-session"):
        result.append(dict(id="niri", name="niri", command=["niri-session"], desktop="niri"))
    return sorted(result, key=lambda item: ("niri" not in item["desktop"].lower(), item["name"]))


if __name__ == "__main__":
    print(json.dumps(dict(sessions=sessions())))
