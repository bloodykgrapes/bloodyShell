#!/usr/bin/env bash

set -euo pipefail

readonly SCHEMA="org.gnome.desktop.interface"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly QT6CT="$CONFIG_HOME/qt6ct/qt6ct.conf"
readonly QT_ENV="$CONFIG_HOME/environment.d/90-bloodyShell-qt.conf"

fail() { printf '%s\n' "$*" >&2; exit 1; }

gget() { gsettings get "$SCHEMA" "$1" 2>/dev/null | sed -E "s/^uint32 //; s/^'(.*)'$/\1/"; }
gset() { gsettings set "$SCHEMA" "$1" "$2" || fail "gsettings could not set $1"; }

ini_set()
{
    local file="$1" section="$2" key="$3" value="$4"
    [[ ! -L "$file" ]] || file="$(readlink -m -- "$file")"
    mkdir -p "$(dirname "$file")"
    [[ -f "$file" ]] || : > "$file"

    local tmp; tmp="$(mktemp "$file.XXXXXX")"
    awk -v sec="[$section]" -v k="$key" -v v="$value" '
        BEGIN { inside = 0; seen = 0; done = 0; blanks = "" }
        /^[ \t]*$/ { blanks = blanks $0 "\n"; next }
        /^\[/ {
            if (inside && !done) { print k "=" v; done = 1 }
            inside = ($0 == sec); if (inside) seen = 1
        }
        inside && index($0, k "=") == 1 { printf "%s", blanks; blanks = ""; if (!done) print k "=" v; done = 1; next }
        { printf "%s", blanks; blanks = ""; print }
        END {
            if (!done) { if (!seen) print sec; print k "=" v }
            printf "%s", blanks
        }' "$file" > "$tmp"
    chmod --reference="$file" "$tmp"
    mv -f -- "$tmp" "$file"
}

ini_get()
{
    [[ -f "$1" ]] || return 0
    awk -v sec="[$2]" -v k="$3" '
        /^\[/ { inside = ($0 == sec) }
        inside && index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }
    ' "$1"
}

qt_styles()
{
    python3 - <<'PY'
import json
import os
from pathlib import Path
import shutil
import subprocess


def tool(name):
    found = shutil.which(name)
    if found:
        return found
    for directory in ("/usr/lib/qt6/bin", "/usr/lib64/qt6/bin", "/usr/lib/qt6/libexec"):
        candidate = Path(directory) / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


roots = [Path(path) for path in os.environ.get("QT_PLUGIN_PATH", "").split(os.pathsep) if path]
paths = tool("qtpaths6") or tool("qtpaths")
if paths:
    try:
        result = subprocess.run([paths, "--plugin-dir"], capture_output=True, text=True, timeout=3)
        if result.returncode == 0 and result.stdout.strip():
            roots.append(Path(result.stdout.strip()))
    except (OSError, subprocess.TimeoutExpired):
        pass
roots += [Path("/usr/lib/qt6/plugins"), Path("/usr/lib64/qt6/plugins")]
roots += list(Path("/usr/lib").glob("*-linux-gnu/qt6/plugins"))
styles = {"fusion": "Fusion", "windows": "Windows"}
excluded = {"qt6ct-style", "qt5ct-style", "qt5gtk2", "gtk2"}
info = tool("qtplugininfo")
seen = set()
for root in roots:
    for plugin in sorted((root / "styles").glob("*.so")):
        if plugin.resolve() in seen:
            continue
        seen.add(plugin.resolve())
        keys = []
        if info:
            try:
                result = subprocess.run([info, "--full-json", str(plugin)], capture_output=True, text=True, timeout=3)
                metadata = json.loads(result.stdout) if result.returncode == 0 else {}
                if metadata:
                    if metadata.get("IID") != "org.qt-project.Qt.QStyleFactoryInterface" or metadata.get("version", 0) >> 16 != 6:
                        continue
                    keys = metadata.get("MetaData", {}).get("Keys", [])
                    if not isinstance(keys, list):
                        keys = []
            except (OSError, ValueError, TypeError, AttributeError, subprocess.TimeoutExpired):
                pass
        if not keys:
            keys = {"libkvantum.so": ["kvantum", "kvantum-dark"], "libbreeze.so": ["Breeze"],
                    "libadwaita.so": ["adwaita", "adwaita-dark"]}.get(plugin.name, [])
        for key in keys:
            if isinstance(key, str) and key and not any(char in key for char in "\n\r\t=") and key.casefold() not in excluded:
                styles.setdefault(key.casefold(), key)
for key in sorted(styles):
    print(styles[key])
PY
}

portal_config()
{
    python3 - "$@" <<'PY'
import configparser
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

PREFIX = "org.freedesktop.impl.portal."
home = Path(os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config"))
data_home = Path(os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share"))
data_dirs = [data_home] + [Path(path) for path in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if path]
desktops = [name.lower() for name in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":") if re.fullmatch(r"[A-Za-z0-9_.-]+", name)]
names = [name + "-portals.conf" for name in desktops] + ["portals.conf"]
roots = [home] + [Path(path) for path in (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":") if path] + [Path("/etc")] + data_dirs + [Path("/usr/share")]


def read(path):
    text = path.read_text(encoding="utf-8-sig")
    values = configparser.ConfigParser(interpolation=None, strict=False)
    values.optionxform = str
    values.read_string(text)
    return text, values


def current():
    for root in roots:
        for name in names:
            path = root / "xdg-desktop-portal" / name
            if path.is_file():
                text, values = read(path)
                return path, text, values
    return None, "", configparser.ConfigParser(interpolation=None)


def backends():
    result = []
    directory = Path(os.environ.get("XDG_DESKTOP_PORTAL_DIR") or "/usr/share/xdg-desktop-portal/portals")
    for path in sorted(directory.glob("*.portal")):
        try:
            _, values = read(path)
            interfaces = sorted({value[len(PREFIX):] for value in values.get("portal", "Interfaces", fallback="").split(";")
                                 if value.startswith(PREFIX) and re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*", value[len(PREFIX):])})
            if interfaces and re.fullmatch(r"[A-Za-z0-9_.-]+", path.stem) and values.get("portal", "DBusName", fallback=""):
                result.append({"id": path.stem, "interfaces": interfaces})
        except (OSError, UnicodeError, configparser.Error):
            continue
    return sorted(result, key=lambda backend: backend["id"])


def update(text, key, value):
    result, inside, seen, written = [], False, False, False
    for line in text.splitlines(keepends=True):
        match = re.match(r"\s*\[([^]]+)\]", line)
        if match:
            if inside and value and not written:
                result.append(key + "=" + value + "\n")
                written = True
            inside = match[1] == "preferred"
            seen = seen or inside
        if inside and "=" in line and line.split("=", 1)[0].strip() == key:
            if value and not written:
                result.append(key + "=" + value + "\n")
                written = True
            continue
        result.append(line)
    if value and not written:
        if result and not result[-1].endswith("\n"):
            result[-1] += "\n"
        if not seen:
            result.append("\n[preferred]\n")
        result.append(key + "=" + value + "\n")
    return "".join(result)


try:
    action = sys.argv[1]
    path, text, values = current()
    installed = backends()
    preferences = {}
    if values.has_section("preferred"):
        for key, value in values.items("preferred"):
            if key == "default" or key.startswith(PREFIX):
                name = key if key == "default" else key[len(PREFIX):]
                preferences[name] = ";".join(item.strip() for item in value.split(";") if item.strip())
    interfaces = sorted(set(preferences).difference({"default"}).union(*(set(backend["interfaces"]) for backend in installed)))
    if action == "read":
        print("portal-data=" + json.dumps({"backends": installed, "preferences": preferences, "interfaces": interfaces}, separators=(",", ":")))
    elif action == "set":
        changes = {}
        for pair in sys.argv[2:]:
            name, separator, value = pair.partition("=")
            if not separator or name not in interfaces + ["default"]:
                raise ValueError("Unknown portal function: " + name)
            for backend in filter(None, value.split(";")):
                if backend in ("none", "*"):
                    continue
                available = next((item for item in installed if item["id"] == backend), None)
                if available is None or name != "default" and name not in available["interfaces"]:
                    raise ValueError("Portal backend does not support " + name + ": " + backend)
            if name == "default" and value and ";" not in value and value not in ("none", "*"):
                value = ";".join([value] + [item for item in preferences.get("default", "").split(";") if item and item != value])
            changes[name] = value
        if not changes or path is None and not any(changes.values()):
            sys.exit(0)
        for name, value in changes.items():
            text = update(text, name if name == "default" else PREFIX + name, value)
        target = path if path is not None and path.parent == home / "xdg-desktop-portal" else home / "xdg-desktop-portal" / names[0]
        target = target.resolve()
        data = text.encode("utf-8")
        if target.is_file() and target.read_bytes() == data:
            sys.exit(0)
        target.parent.mkdir(parents=True, exist_ok=True)
        mode = stat.S_IMODE(target.stat().st_mode) if target.exists() else 0o600
        descriptor, temporary = tempfile.mkstemp(prefix="." + target.name + "-", dir=target.parent)
        try:
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(data)
                stream.flush()
                os.fsync(stream.fileno())
                os.fchmod(stream.fileno(), mode)
            os.replace(temporary, target)
        finally:
            Path(temporary).unlink(missing_ok=True)
except (OSError, UnicodeError, ValueError, configparser.Error) as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
PY
}

kdl_string() { local s="${1//\\/\\\\}"; printf '"%s"' "${s//\"/\\\"}"; }

cmd_list()
{
    local dir theme
    printf 'gtk\t%s\n' Adwaita Adwaita-dark HighContrast
    for dir in /usr/share/themes "$HOME/.themes" "$DATA_HOME/themes"; do
        for theme in "$dir"/*/; do
            [[ -f "${theme}gtk-3.0/gtk.css" || -f "${theme}gtk-4.0/gtk.css" ]] && printf 'gtk\t%s\n' "$(basename "$theme")"
        done
    done
    for dir in /usr/share/icons "$HOME/.icons" "$DATA_HOME/icons"; do
        for theme in "$dir"/*/; do
            local name; name="$(basename "$theme")"
            [[ "$name" == "default" ]] && continue
            [[ -d "${theme}cursors" ]] && printf 'cursor\t%s\n' "$name"
            [[ -f "${theme}index.theme" ]] && grep -q '^Directories=' "${theme}index.theme" && printf 'icon\t%s\n' "$name"
        done
    done
    if command -v fc-list > /dev/null; then
        fc-list : family 2>/dev/null | cut -d, -f1 | sed 's/^ *//; s/ *$//' | grep -v '^$' | sed 's/^/font\t/'
    fi
    qt_styles | sed 's/^/qt\t/'
}

cmd_read()
{
    command -v gsettings > /dev/null || fail "gsettings is not installed"
    printf 'color-scheme=%s\n' "$(gget color-scheme)"
    printf 'gtk-theme=%s\n'    "$(gget gtk-theme)"
    printf 'icon-theme=%s\n'   "$(gget icon-theme)"
    printf 'cursor-theme=%s\n' "$(gget cursor-theme)"
    printf 'cursor-size=%s\n'  "$(gget cursor-size)"
    printf 'font=%s\n'         "$(gget font-name)"
    command -v qt6ct > /dev/null && echo "qt6ct=yes" || echo "qt6ct=no"
    printf 'qt-theme=%s\n' "$(ini_get "$QT6CT" Appearance style)"
    case "${QT_QPA_PLATFORMTHEME:-}" in
        qt6ct|qt6ct:*|qt5ct|qt5ct:*) echo 'qt-active=yes' ;;
        *) echo 'qt-active=no' ;;
    esac
    if [[ -f "$QT_ENV" ]] && grep -qx 'QT_QPA_PLATFORMTHEME=qt6ct' "$QT_ENV"; then
        echo 'qt-configured=yes'
    else
        echo 'qt-configured=no'
    fi
    portal_config read
}

write_qt_theme()
{
    command -v qt6ct > /dev/null || fail "Install qt6ct to configure Qt application themes"
    local theme="$1" available="" candidate
    while IFS= read -r candidate; do
        if [[ "${candidate,,}" == "${theme,,}" ]]; then available="$candidate"; break; fi
    done < <(qt_styles)
    [[ -n "$available" ]] || fail "Qt style is not installed: $theme"
    ini_set "$QT6CT" Appearance style "$available"
    case "${QT_QPA_PLATFORMTHEME:-}" in qt6ct|qt6ct:*|qt5ct|qt5ct:*) return 0 ;; esac
    mkdir -p "$(dirname "$QT_ENV")"
    printf 'QT_QPA_PLATFORMTHEME=qt6ct\n' > "$QT_ENV"
    if command -v dbus-update-activation-environment > /dev/null \
        && timeout 3 dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME=qt6ct > /dev/null 2>&1; then
        return 0
    fi
    if command -v systemctl > /dev/null; then
        timeout 3 systemctl --user set-environment QT_QPA_PLATFORMTHEME=qt6ct > /dev/null 2>&1 || true
    fi
}

write_color_scheme()
{
    local scheme="$1" dark=false
    [[ "$scheme" == "prefer-dark" ]] && dark=true
    gset color-scheme "$scheme"
    ini_set "$CONFIG_HOME/gtk-3.0/settings.ini" Settings gtk-application-prefer-dark-theme "$dark"
    ini_set "$CONFIG_HOME/gtk-4.0/settings.ini" Settings gtk-interface-color-scheme "$scheme"

    local palette=/usr/share/qt6ct/colors/darker.conf
    if $dark && [[ -f "$palette" ]]; then
        ini_set "$QT6CT" Appearance custom_palette true
        ini_set "$QT6CT" Appearance color_scheme_path "$palette"
    else
        ini_set "$QT6CT" Appearance custom_palette false
    fi
}

write_gtk_theme()
{
    gset gtk-theme "$1"
    ini_set "$CONFIG_HOME/gtk-3.0/settings.ini" Settings gtk-theme-name "$1"
    ini_set "$CONFIG_HOME/gtk-4.0/settings.ini" Settings gtk-theme-name "$1"
}

write_icon_theme()
{
    gset icon-theme "$1"
    ini_set "$CONFIG_HOME/gtk-3.0/settings.ini" Settings gtk-icon-theme-name "$1"
    ini_set "$CONFIG_HOME/gtk-4.0/settings.ini" Settings gtk-icon-theme-name "$1"
    ini_set "$QT6CT" Appearance icon_theme "$1"
}

write_font()
{
    local font="$1"
    local size="${font##* }" family="${font% *}"
    [[ "$size" =~ ^[0-9]+([.][0-9]+)?$ ]] || { size=10; family="$font"; }

    gset font-name "$family $size"
    ini_set "$CONFIG_HOME/gtk-3.0/settings.ini" Settings gtk-font-name "$family $size"
    ini_set "$CONFIG_HOME/gtk-4.0/settings.ini" Settings gtk-font-name "$family $size"
    ini_set "$QT6CT" Fonts general "\"$family,$size,-1,5,50,0,0,0,0,0\""
}

write_cursor()
{
    local theme="$1" size="$2"
    gset cursor-theme "$theme"
    gset cursor-size "$size"
    ini_set "$CONFIG_HOME/gtk-3.0/settings.ini" Settings gtk-cursor-theme-name "$theme"
    ini_set "$CONFIG_HOME/gtk-3.0/settings.ini" Settings gtk-cursor-theme-size "$size"
    ini_set "$CONFIG_HOME/gtk-4.0/settings.ini" Settings gtk-cursor-theme-name "$theme"
    ini_set "$CONFIG_HOME/gtk-4.0/settings.ini" Settings gtk-cursor-theme-size "$size"

    mkdir -p "$DATA_HOME/icons/default"
    printf '[Icon Theme]\nName=Default\nInherits=%s\n' "$theme" > "$DATA_HOME/icons/default/index.theme"

    write_niri_cursor "$theme" "$size"
    return 0
}

write_niri_cursor()
{
    [[ -d "$CONFIG_HOME/niri/bloodyShell" ]] || return 0
    "$(dirname "$0")/niri-config" write 08-appearance.kdl "$(
        echo "// Создаётся bloodyShell (Settings → Appearance): правки вручную перезапишутся."
        echo "cursor {"
        echo "    xcursor-theme $(kdl_string "$1")"
        echo "    xcursor-size $2"
        echo "}"
    )" || fail "niri did not accept the cursor settings; its config was left unchanged"
}

cmd_set()
{
    command -v gsettings > /dev/null || fail "gsettings is not installed"

    local theme="" size="" cursor=false
    local -a portals=()
    local portal_dialogs=false
    for pair in "$@"; do
        local key="${pair%%=*}" value="${pair#*=}"
        case "$key" in
            color-scheme) write_color_scheme "$value" ;;
            gtk-theme)    write_gtk_theme "$value" ;;
            qt-theme)     write_qt_theme "$value" ;;
            portal:*)
                local interface="${key#portal:}"
                portals+=("$interface=$value")
                [[ "$interface" != FileChooser && "$interface" != default ]] || portal_dialogs=true
                ;;
            icon-theme)   write_icon_theme "$value" ;;
            font)         write_font "$value" ;;
            cursor-theme) theme="$value"; cursor=true ;;
            cursor-size)  size="$value";  cursor=true ;;
            *) fail "Unknown setting: $key" ;;
        esac
    done

    if [[ ${#portals[@]} -gt 0 ]]; then
        portal_config set "${portals[@]}"
        if $portal_dialogs && command -v qt6ct > /dev/null; then ini_set "$QT6CT" Appearance standard_dialogs xdgdesktopportal; fi
    fi

    if $cursor; then
        [[ -n "$theme" ]] || theme="$(gget cursor-theme)"
        [[ -n "$size" ]] || size="$(gget cursor-size)"
        write_cursor "$theme" "$size"
    fi
}

cmd_apply()
{
    local qt_theme
    qt_theme="$(ini_get "$QT6CT" Appearance style)"
    cmd_set "color-scheme=$(gget color-scheme)" "gtk-theme=$(gget gtk-theme)" "icon-theme=$(gget icon-theme)" \
            "font=$(gget font-name)" "cursor-theme=$(gget cursor-theme)" "cursor-size=$(gget cursor-size)"
    if [[ -n "$qt_theme" ]] && command -v qt6ct > /dev/null; then write_qt_theme "$qt_theme"; fi
}

cmd_icons()
{
    local -a bases=("$DATA_HOME/icons" "$HOME/.icons" /usr/share/icons /usr/local/share/icons)
    local -a chain=() queue=("${1:-hicolor}")
    while [[ ${#queue[@]} -gt 0 ]]; do
        local theme="${queue[0]}"; queue=("${queue[@]:1}")
        [[ " ${chain[*]} " == *" $theme "* ]] && continue
        chain+=("$theme")
        local base
        for base in "${bases[@]}"; do
            [[ -f "$base/$theme/index.theme" ]] || continue
            local inherits; inherits="$(sed -n 's/^Inherits=//p' "$base/$theme/index.theme" | head -n1)"
            IFS=',' read -ra more <<< "$inherits"
            queue+=("${more[@]}")
            break
        done
    done
    [[ " ${chain[*]} " == *" hicolor "* ]] || chain+=(hicolor)

    local i=0 theme base
    for theme in "${chain[@]}"; do
        for base in "${bases[@]}"; do
            [[ -d "$base/$theme" ]] || continue
            find -L "$base/$theme" \( -name '*.svg' -o -name '*.png' \) -type f 2>/dev/null | sed "s|^|$i\t|"
        done
        i=$((i + 1))
    done | awk -F'\t' '
        {
            path = $2; name = path; sub(/.*\//, "", name); sub(/\.(svg|png)$/, "", name)
            rank = 500
            if (path ~ /\/scalable\//) rank = 0
            else if (match(path, /\/[0-9]+(x[0-9]+)?(@[0-9]x)?\//)) { size = substr(path, RSTART + 1, RLENGTH - 2) + 0; rank = 400 - (size > 256 ? 256 : size) }
            printf "%d\t%03d\t%s\t%s\n", $1, rank, name, path
        }' | sort -t$'\t' -k1,1n -k2,2n | awk -F'\t' '!seen[$3]++ { print $3 "\t" $4 }'
}

case "${1:-}" in
    read)  cmd_read ;;
    list)  cmd_list | sort -u ;;
    icons) cmd_icons "${2:-}" ;;
    set)   shift; cmd_set "$@" ;;
    apply) cmd_apply ;;
    *) printf '%s\n' 'Usage: appearance {read|list|icons [theme]|set key=value...|apply}'; exit 1 ;;
esac
