#!/usr/bin/env python3

import argparse
from contextlib import contextmanager
from datetime import datetime
import filecmp
import json
import os
from pathlib import Path, PurePosixPath
import re
import runpy
import shutil
import subprocess
import sys
import tarfile
import tempfile
import uuid

ROOT = Path(__file__).resolve().parents[2]
REPO = "bloodykgrapes/bloodyShell"
BRANCH = "main"
IMAGES = {".jpg", ".jpeg", ".png", ".webp", ".bmp"}


def home():
    return Path(os.environ.get("HOME", str(Path.home())))


def config_home():
    return Path(os.environ.get("XDG_CONFIG_HOME", str(home() / ".config")))


def wallpapers_dir():
    return home() / "Pictures/Wallpapers"


def program_name(value):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", value):
        raise ValueError("Invalid app configuration name")
    return value


def download(url, destination=None):
    command = ["curl", "-fsSL", "--retry", "1", "--max-time", "120" if destination else "20"]
    if destination:
        command += ["-o", str(destination)]
    result = subprocess.run(command + [url], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Could not download repository files")
    return result.stdout


def programs():
    source = ROOT / "dots"
    if source.is_dir():
        return sorted(path.name for path in source.iterdir() if path.is_dir() and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", path.name))
    data = json.loads(download(f"https://api.github.com/repos/{REPO}/contents/dots?ref={BRANCH}"))
    if not isinstance(data, list):
        raise ValueError("Invalid repository response")
    return sorted(program_name(item["name"]) for item in data if item.get("type") == "dir")


def resource_path(resource):
    if resource == "wallpapers":
        return Path("assets/wallpapers")
    if resource == "greeter":
        return Path("greeter")
    if resource.startswith("dots/"):
        return Path("dots") / program_name(resource[5:])
    raise ValueError("Unknown repository resource")


@contextmanager
def source_for(resource):
    relative = resource_path(resource)
    if (ROOT / relative).is_dir():
        yield ROOT
        return
    with tempfile.TemporaryDirectory(prefix="bloodyShell-import-") as temporary:
        stage = Path(temporary)
        archive = stage / "source.tar.gz"
        download(f"https://github.com/{REPO}/archive/refs/heads/{BRANCH}.tar.gz", archive)
        with tarfile.open(archive, "r:gz") as package:
            total = 0
            for member in package:
                parts = PurePosixPath(member.name).parts
                if len(parts) < 2:
                    continue
                path = PurePosixPath(*parts[1:])
                if path.is_absolute() or ".." in path.parts:
                    raise ValueError("Unsafe repository archive path")
                if not path.is_relative_to(PurePosixPath(relative.as_posix())):
                    continue
                target = stage / path
                if member.isdir():
                    target.mkdir(parents=True, exist_ok=True)
                elif member.isfile():
                    total += member.size
                    if total > 512 * 1024 * 1024:
                        raise ValueError("Repository resource is too large")
                    target.parent.mkdir(parents=True, exist_ok=True)
                    with package.extractfile(member) as src, target.open("wb") as dest:
                        shutil.copyfileobj(src, dest)
                    target.chmod(member.mode & 0o755)
                else:
                    raise ValueError("Repository resources cannot contain links or special files")
        if not (stage / relative).is_dir():
            raise ValueError("The repository does not contain this resource")
        yield stage


def copy_image(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    candidate = destination
    number = 0
    while candidate.exists() or candidate.is_symlink():
        if candidate.is_file() and not candidate.is_symlink() and filecmp.cmp(source, candidate, shallow=False):
            return candidate, False
        number += 1
        suffix = "-bloodyShell" + (f"-{number}" if number > 1 else "")
        candidate = destination.with_name(destination.stem + suffix + destination.suffix)
    try:
        descriptor = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
    except FileExistsError:
        return copy_image(source, destination)
    try:
        with os.fdopen(descriptor, "wb") as dest, source.open("rb") as src:
            shutil.copyfileobj(src, dest)
    except BaseException:
        candidate.unlink(missing_ok=True)
        raise
    return candidate, True


def write_settings(path, settings):
    target = path.resolve()
    descriptor, temporary = tempfile.mkstemp(prefix=".wallpapers-", dir=target.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            os.fchmod(stream.fileno(), target.stat().st_mode & 0o777)
            json.dump(settings, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)


def import_wallpapers(source):
    source = Path(source).resolve()
    if not source.is_dir():
        raise ValueError("Wallpaper source is missing")
    directory = wallpapers_dir()
    settings_path = config_home() / "bloodyShell/settings.json"
    settings = json.loads(settings_path.read_text()) if settings_path.is_file() else {}
    if not isinstance(settings, dict):
        raise ValueError("Invalid shell settings")
    legacy = {source, (ROOT / "assets/wallpapers").resolve(), (config_home() / "quickshell/bloodyShell/assets/wallpapers").resolve()}
    old_directory = Path(str(settings.get("wallpaperDirectory", ""))).expanduser().resolve()
    sources = [old_directory] if old_directory in legacy and old_directory.is_dir() and old_directory != source else []
    sources.append(source)
    copied = 0
    mapping = {}
    relative_paths = {}
    for folder in sources:
        for image in sorted(folder.rglob("*")):
            if not image.is_file() or image.is_symlink() or image.suffix.lower() not in IMAGES:
                continue
            relative = image.relative_to(folder)
            destination, created = copy_image(image, directory / relative)
            copied += int(created)
            mapping[str(image.resolve())] = str(destination)
            relative_paths[relative] = str(destination)
    changes = {}
    if old_directory in legacy:
        changes["wallpaperDirectory"] = str(directory)
    current = str(settings.get("wallpaperCurrent", "")).removeprefix("file://")
    if current:
        old_current = Path(current).expanduser().resolve()
        if str(old_current) in mapping:
            changes["wallpaperCurrent"] = mapping[str(old_current)]
        else:
            for folder in legacy:
                if old_current.is_relative_to(folder) and old_current.relative_to(folder) in relative_paths:
                    changes["wallpaperCurrent"] = relative_paths[old_current.relative_to(folder)]
                    break
    if changes and settings_path.is_file():
        write_settings(settings_path, dict(settings, **changes))
    return dict(destination=str(directory), imported=copied, settings=changes)


def import_config(source, program):
    program_name(program)
    destination = config_home() / program
    destination.parent.mkdir(parents=True, exist_ok=True)
    backup = None
    with tempfile.TemporaryDirectory(prefix=".bloodyShell-config-", dir=destination.parent) as temporary:
        staged = Path(temporary) / program
        shutil.copytree(source, staged, symlinks=True)
        if destination.exists() or destination.is_symlink():
            stamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S") + "-import-" + uuid.uuid4().hex[:8]
            backup = home() / "bloodyShell.bak" / stamp / program
            backup.parent.mkdir(parents=True)
            shutil.move(str(destination), backup)
        try:
            os.replace(staged, destination)
        except OSError:
            if backup is not None:
                shutil.move(str(backup), destination)
            raise
    return dict(destination=str(destination), backup=str(backup) if backup else "")


def import_resource(resource):
    with source_for(resource) as source:
        relative = resource_path(resource)
        if resource == "wallpapers":
            return import_wallpapers(source / relative)
        if resource.startswith("dots/"):
            return import_config(source / relative, resource[5:])
        environment = dict(os.environ, BLOODYSHELL_RESOURCE_DIR=str(source))
        result = subprocess.run(["bash", str(ROOT / "setup"), "greetd"], env=environment)
        if result.returncode:
            raise RuntimeError("Greeter setup failed")
        return dict(destination="/usr/share/quickshell/bloodyShell-greeter")


def status():
    dependencies = runpy.run_path(str(ROOT / "scripts/runtime/dependencies"))
    return dict(source="local" if (ROOT / "dots").is_dir() else "repository", terminal=dependencies["terminal"](), entries=[
        dict(id="dots/" + name, kind="dots", name=name, destination=str(config_home() / name)) for name in programs()
    ] + [dict(id="greeter", kind="greeter", name="greeter", destination="/usr/share/quickshell/bloodyShell-greeter"),
         dict(id="wallpapers", kind="wallpapers", name="wallpapers", destination=str(wallpapers_dir()))])


def main():
    parser = argparse.ArgumentParser(description="Import optional bloodyShell repository files")
    parser.add_argument("action", choices=("status", "programs", "import", "seed-wallpapers"))
    parser.add_argument("resource", nargs="?")
    parser.add_argument("--wait", action="store_true")
    parser.add_argument("--human", action="store_true")
    args = parser.parse_args()
    try:
        if args.action == "status":
            print(json.dumps(status()))
        elif args.action == "programs":
            print("\n".join(programs()))
        elif args.action == "seed-wallpapers":
            if not args.resource:
                raise ValueError("Wallpaper source is required")
            print(json.dumps(import_wallpapers(args.resource)))
        else:
            if not args.resource:
                raise ValueError("Resource name is required")
            result = import_resource(args.resource)
            if args.human or args.wait:
                print("Imported → " + result["destination"])
                if result.get("backup"):
                    print("Backup → " + result["backup"])
            else:
                print(json.dumps(result))
        return 0
    except (OSError, ValueError, RuntimeError, tarfile.TarError) as error:
        print(str(error), file=sys.stderr)
        return 1
    finally:
        if args.wait and sys.stdin.isatty():
            try:
                input("\nPress Enter to close…")
            except (EOFError, KeyboardInterrupt):
                pass


if __name__ == "__main__":
    sys.exit(main())
