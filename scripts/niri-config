#!/usr/bin/env bash

set -euo pipefail

readonly CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly NIRI_CONFIG="$CONFIG_HOME/niri/config.kdl"
readonly DIR="$CONFIG_HOME/niri/bloodyShell"

fail() { printf '%s\n' "$*" >&2; exit 1; }

cmd_write()
{
    local name="$1" content="$2"
    [[ "$name" =~ ^[0-9A-Za-z._-]+\.kdl$ ]] || fail "Bad niri file name: $name"
    [[ -d "$DIR" ]] || fail "No $DIR: the niri config from bloodyShell is not installed"

    local file="$DIR/$name" backup="" config_backup=""
    if [[ -f "$file" ]]; then backup="$(mktemp)"; cp "$file" "$backup"; fi
    if [[ -f "$NIRI_CONFIG" ]]; then config_backup="$(mktemp)"; cp "$NIRI_CONFIG" "$config_backup"; fi

    printf '%s\n' "$content" > "$file"
    if [[ -f "$NIRI_CONFIG" ]] && ! grep -q "bloodyShell/$name" "$NIRI_CONFIG"; then
        printf '\ninclude "bloodyShell/%s"\n' "$name" >> "$NIRI_CONFIG"
    fi

    if command -v niri > /dev/null && ! niri validate > /dev/null 2>&1; then
        if [[ -n "$backup" ]]; then cp "$backup" "$file"; else rm -f "$file"; fi
        if [[ -n "$config_backup" ]]; then cp "$config_backup" "$NIRI_CONFIG"; fi
        rm -f "$backup" "$config_backup"
        fail "niri did not accept the new $name; the config was left unchanged"
    fi
    rm -f "$backup" "$config_backup"
}

case "${1:-}" in
    write) [[ $# -eq 3 ]] || fail "Usage: niri-config write <name> <content>"; cmd_write "$2" "$3" ;;
    *) printf '%s\n' 'Usage: niri-config write <name> <content>'; exit 1 ;;
esac
