#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SHELL_PATH="$(python3 -c 'import json, sys; print(json.dumps(sys.argv[1], ensure_ascii=False))' "$ROOT")"
CONTENT="recent-windows {
    off
}

binds {
    Alt+Tab repeat=false { spawn \"qs\" \"-p\" $SHELL_PATH \"ipc\" \"call\" \"altTab\" \"begin\" \"false\"; }
    Alt+Shift+Tab repeat=false { spawn \"qs\" \"-p\" $SHELL_PATH \"ipc\" \"call\" \"altTab\" \"begin\" \"true\"; }
}"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
BINDINGS="$CONFIG_DIR/bloodyShell/09-alt-tab.kdl"

if [[ -f "$BINDINGS" && -f "$CONFIG_DIR/config.kdl" ]] &&
    [[ "$(cat -- "$BINDINGS")" == "$CONTENT" ]] &&
    grep -Eq '^[[:space:]]*include[[:space:]]+"bloodyShell/09-alt-tab\.kdl"[[:space:]]*$' "$CONFIG_DIR/config.kdl"; then
    exit 0
fi

exec "$ROOT/scripts/niri-config" write "09-alt-tab.kdl" "$CONTENT"
