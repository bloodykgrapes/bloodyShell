#!/usr/bin/env python3

import json
import os
from pathlib import Path
import shlex
import shutil
import sys
import tempfile


def replace(path, contents, mode):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(contents)
            os.fchmod(stream.fileno(), mode)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def install(source, binary, config, home, backup, shell, path):
    changed = []
    saved = []

    def save(target, label, follow=False):
        if target.exists() or target.is_symlink():
            destination = backup / label
            destination.parent.mkdir(parents=True, exist_ok=True)
            if destination.exists() or destination.is_symlink():
                raise RuntimeError(f"Backup already exists: {destination}")
            if target.is_symlink() and not follow:
                destination.symlink_to(os.readlink(target))
            else:
                shutil.copy2(target, destination)
            saved.append(str(destination))

    command = binary / "bloodyShell"
    contents = source.read_bytes()
    if command.is_dir() and not command.is_symlink():
        raise RuntimeError(f"Command path is a directory: {command}")
    if command.is_symlink() or not command.is_file() or command.read_bytes() != contents:
        save(command, "command")
        replace(command, contents, 0o755)
        changed.append(str(command))
    else:
        command.chmod(0o755)

    def write(target, contents, label):
        data = contents.encode()
        if target.is_file() and target.read_bytes() == data:
            return
        save(target, label)
        replace(target, data, 0o644)
        changed.append(str(target))

    def append(target, line, label):
        contents = target.read_text() if target.exists() else ""
        if line in contents.splitlines():
            return
        save(target, label, follow=True)
        mode = target.stat().st_mode & 0o777 if target.exists() else 0o644
        replace(target.resolve() if target.is_symlink() else target, (contents.rstrip("\n") + "\n\n" + line + "\n").encode(), mode)
        changed.append(str(target))

    on_path = str(binary) in path.split(os.pathsep)
    if not on_path:
        kind = Path(shell).name
        if kind == "fish":
            escaped = str(binary).replace("\\", "\\\\").replace("'", "\\'")
            write(config / "fish/conf.d/bloodyShell.fish",
                  f"if not contains -- '{escaped}' $PATH\n    set -gx PATH '{escaped}' $PATH\nend\n", "fish-path")
        else:
            script = config / "bloodyShell/shell-path.sh"
            quoted = shlex.quote(str(binary))
            write(script, 'case ":${PATH:-}:" in\n    *:' + quoted + ':*) ;;\n    *) export PATH=' + quoted + ':"${PATH:-}" ;;\nesac\n', "shell-path")
            line = ". " + shlex.quote(str(script))
            if kind == "zsh":
                append(Path(os.environ.get("ZDOTDIR") or home) / ".zshenv", line, "zshenv")
            elif kind in ("bash", "sh", "dash", ""):
                if kind in ("bash", ""):
                    append(home / ".bashrc", line, "bashrc")
                    profile = next((home / name for name in (".bash_profile", ".bash_login", ".profile") if (home / name).exists()), home / ".profile")
                else:
                    profile = home / ".profile"
                append(profile, line, "profile")
            else:
                return dict(command=str(command), changed=changed, backups=saved, path=False, manual=str(script))
    return dict(command=str(command), changed=changed, backups=saved, path=on_path, manual=None)


def main():
    if len(sys.argv) != 4:
        raise RuntimeError("Usage: install-command SOURCE BIN_DIR BACKUP_DIR")
    home = Path.home()
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    result = install(Path(sys.argv[1]), Path(sys.argv[2]), config, home, Path(sys.argv[3]), os.environ.get("SHELL", "bash"), os.environ.get("PATH", ""))
    print(json.dumps(result))


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        print(f"Could not install bloodyShell command: {error}", file=sys.stderr)
        sys.exit(1)
