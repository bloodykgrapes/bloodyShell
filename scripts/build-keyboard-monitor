#!/usr/bin/env python3

import fcntl
import hashlib
import os
from pathlib import Path
import platform
import shlex
import shutil
import subprocess
import sys


SOURCE = Path(__file__).resolve().parents[1] / "modules/keyboard"


def output(args):
    return subprocess.check_output(args, text=True, stderr=subprocess.PIPE).strip()


def write_changed(path, data):
    if not path.exists() or path.read_bytes() != data:
        path.write_bytes(data)


def build(cache, library):
    compiler = shutil.which("c++") or shutil.which("g++")
    if not compiler:
        raise RuntimeError("A C++ compiler is required for the Alt+Tab keyboard monitor")
    libexec = Path(output(["pkg-config", "--variable=libexecdir", "Qt6Core"]))
    moc = next((path for path in (libexec / "moc", libexec / "libexec/moc") if path.is_file()), None)
    if not moc:
        raise RuntimeError("Qt 6 moc is required for the Alt+Tab keyboard monitor")
    flags = shlex.split(output(["pkg-config", "--cflags", "--libs", "Qt6Quick"]))
    includes = [flag for flag in flags if flag.startswith(("-I", "-D"))]
    subprocess.run([str(moc), *includes, str(SOURCE / "KeyboardMonitor.cpp"), "-o", str(cache / "keyboard.moc")], check=True)
    temporary = library.with_suffix(".so.tmp")
    try:
        subprocess.run([compiler, "-std=c++17", "-shared", "-fPIC", "-O2", "-I" + str(cache),
                        str(SOURCE / "KeyboardMonitor.cpp"), "-o", str(temporary), *flags], check=True)
        temporary.replace(library)
    finally:
        temporary.unlink(missing_ok=True)


def main():
    version = output(["pkg-config", "--modversion", "Qt6Quick"])
    inputs = SOURCE.joinpath("KeyboardMonitor.cpp").read_bytes() + SOURCE.joinpath("Monitor.qml").read_bytes()
    digest = hashlib.sha256(inputs + version.encode() + platform.machine().encode()).hexdigest()[:16]
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "bloodyShell/keyboard" / digest
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (cache / "build.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        plugin = cache / "plugin"
        plugin.mkdir(exist_ok=True)
        library = plugin / "libkeyboardstate.so"
        if not library.exists():
            build(cache, library)
        write_changed(plugin / "qmldir", b"module BloodyShell.Keyboard\nplugin keyboardstate\n")
        write_changed(cache / "Monitor.qml", (SOURCE / "Monitor.qml").read_bytes())
    print((cache / "Monitor.qml").as_uri())


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print("Keyboard monitor: " + str(error), file=sys.stderr)
        sys.exit(1)
