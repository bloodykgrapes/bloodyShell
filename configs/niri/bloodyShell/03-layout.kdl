layout {
    background-color "transparent"

    gaps 10

    center-focused-column "never"

    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33
        proportion 0.5
        proportion 0.67
    }


    focus-ring {
        width 1

        active-color "#ffffff"
        inactive-color "#505050"
    }

    struts {
    }
}

animations {

    window-open {
        duration-ms 250
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 250
        curve "ease-out-quad"
    }
}

prefer-no-csd

overview {
    backdrop-color "#141416"
}

blur {
    passes 3
    offset 3.3
    noise 0.02
    saturation 1.3
}
