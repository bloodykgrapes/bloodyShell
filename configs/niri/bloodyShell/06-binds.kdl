hotkey-overlay { skip-at-startup; }

binds {
    XF86AudioRaiseVolume allow-inhibiting=false allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"; }
    XF86AudioLowerVolume allow-inhibiting=false allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-inhibiting=false allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-inhibiting=false allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay allow-inhibiting=false allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-inhibiting=false allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-inhibiting=false allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-inhibiting=false allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp   allow-inhibiting=false allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-inhibiting=false allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"; }
    Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ -l 1.0"; }

    Print      { screenshot; }
    Alt+Print  { screenshot-window; }
    Ctrl+Print { screenshot-screen; }


    Mod+E repeat=false { spawn "nautilus"; }
    Mod+T repeat=false { spawn "kitty"; }
    Mod+B repeat=false { spawn "kitty" "-e" "btop"; }

    Mod+D allow-inhibiting=false repeat=false { spawn-sh "qs -c bloodyShell ipc call launcher toggle"; }
    Mod+I allow-inhibiting=false repeat=false { spawn-sh "qs -c bloodyShell ipc call settings toggle"; }
    Mod+P allow-inhibiting=false repeat=false { spawn-sh "qs -c bloodyShell ipc call power toggle"; }
    Mod+Y allow-inhibiting=false repeat=false { spawn-sh "qs -c bloodyShell ipc call wallpapers toggle"; }
    Mod+L allow-inhibiting=false repeat=false { spawn-sh "qs -c bloodyShell ipc call lock lock"; }


    Mod+Q   repeat=false { close-window; }
    Mod+Tab repeat=false { toggle-overview; }

    Mod+W       { toggle-column-tabbed-display; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+C      { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+M       { maximize-window-to-edges; }
    Mod+F       { maximize-column; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+Shift+F { fullscreen-window; }

    Mod+R      { switch-preset-column-width; }
    Mod+Ctrl+R { switch-preset-column-width-back; }

    Mod+Shift+R      { switch-preset-window-height; }
    Mod+Shift+Ctrl+R { reset-window-height; }

    Mod+Ctrl+Minus { set-column-width "-10%"; }
    Mod+Ctrl+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Up    { focus-window-up;   }
    Mod+Down  { focus-window-down; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }

    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }

    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    Mod+WheelScrollUp    cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown  cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollLeft  cooldown-ms=150 { focus-column-left; }
    Mod+WheelScrollRight cooldown-ms=150 { focus-column-right; }

    Mod+Shift+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollLeft  cooldown-ms=150 { move-column-left; }
    Mod+Shift+WheelScrollRight cooldown-ms=150 { move-column-right; }

    Mod+Shift+TouchpadScrollUp    cooldown-ms=400 { move-column-to-workspace-up; }
    Mod+Shift+TouchpadScrollDown  cooldown-ms=400 { move-column-to-workspace-down; }
    Mod+Shift+TouchpadScrollLeft  cooldown-ms=250 { move-column-left; }
    Mod+Shift+TouchpadScrollRight cooldown-ms=250 { move-column-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Ctrl+Alt+Delete { quit; }


    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
