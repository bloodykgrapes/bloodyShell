readonly APPLICATIONS=(
    "Web browser|firefox|Firefox|General-purpose web browser|firefox|firefox|firefox-esr"
    "Web browser|chromium|Chromium|Chromium-based web browser|chromium|chromium|chromium"
    "Media player|mpv|mpv|Lightweight audio and video player|mpv|mpv|mpv"
    "Media player|vlc|VLC|Audio and video player with a full interface|vlc|vlc|vlc"
    "Media player|celluloid|Celluloid|Simple graphical player based on mpv|celluloid|celluloid|celluloid"
    "Image viewer|imv|imv|Lightweight image viewer|imv|imv|imv"
    "Image viewer|gwenview|Gwenview|Graphical image viewer|gwenview|gwenview|gwenview"
    "Text editor|kate|Kate|Full-featured graphical editor|kate|kate|kate"
    "Text editor|mousepad|Mousepad|Simple graphical text editor|mousepad|mousepad|mousepad"
    "Text editor|gnome-text-editor|GNOME Text Editor|Minimal graphical editor|gnome-text-editor|gnome-text-editor|gnome-text-editor"
)

application_installed() { command -v "$1" > /dev/null; }

application_packages()
{
    local family="$1" line="$2" category tool label description arch fedora debian
    IFS='|' read -r category tool label description arch fedora debian <<< "$line"
    if [[ "$family" == debian && "$(os_field ID)" == ubuntu ]]; then
        [[ "$tool" != firefox ]] || debian=firefox
        [[ "$tool" != chromium ]] || debian=chromium-browser
    fi
    dependency_packages "$family" "optional|$tool|$description|$arch|$fedora|$debian"
}

install_applications()
{
    interactive || { info "Optional program choices require an interactive terminal"; return 0; }
    local family; family="$(distro_family)"
    [[ -n "$family" ]] || { warn "Choose optional programs with your distribution's package manager"; return 0; }

    local category line group tool label description packages installed
    local chosen=() choices=() package_lines=() candidates=() all_packages=()
    for category in "Web browser" "Media player" "Image viewer" "Text editor"; do
        installed=""
        local alternatives=""
        case "$category" in
            "Web browser") alternatives="brave brave-browser google-chrome google-chrome-stable vivaldi librewolf zen-browser" ;;
            "Media player") alternatives="haruna parole totem dragon" ;;
            "Image viewer") alternatives="eog loupe ristretto feh qimgv" ;;
            "Text editor") alternatives="code codium gedit xed leafpad" ;;
        esac
        for tool in $alternatives; do
            if application_installed "$tool"; then installed="$tool"; break; fi
        done
        if [[ -n "$installed" ]]; then info "$category: $installed is installed"; continue; fi
        candidates=()
        all_packages=()
        for line in "${APPLICATIONS[@]}"; do
            IFS='|' read -r group tool label description _ <<< "$line"
            [[ "$group" == "$category" ]] || continue
            if application_installed "$tool"; then installed="$label"; break; fi
            candidates+=("$line")
            packages="$(application_packages "$family" "$line")"
            [[ -z "$packages" ]] || all_packages+=($packages)
        done
        if [[ -n "$installed" ]]; then info "$category: $installed is installed"; continue; fi
        [[ ${#all_packages[@]} -gt 0 ]] || continue
        query_available "$family" "${all_packages[@]}"
        choices=("None|Skip this category")
        package_lines=("")
        for line in "${candidates[@]}"; do
            IFS='|' read -r group tool label description _ <<< "$line"
            packages="$(application_packages "$family" "$line")"
            [[ -n "$packages" ]] && line_available "$packages" || continue
            choices+=("$label|$description")
            package_lines+=("$packages")
        done
        [[ ${#choices[@]} -gt 1 ]] || { info "$category: no matching repository packages found"; continue; }
        choose "$category · optional" "${choices[@]}"
        [[ "$CHOICE" -ne 0 ]] || { info "Optional program selection cancelled"; return 0; }
        if (( CHOICE > 1 )); then chosen+=(${package_lines[$((CHOICE - 1))]}); fi
    done
    [[ ${#chosen[@]} -gt 0 ]] || { info "No extra programs selected"; return 0; }
    if ask "Install selected programs: ${chosen[*]}? (needs sudo)" y; then
        install_packages "$family" "${chosen[@]}" || { warn "Some selected programs could not be installed"; return 0; }
        ok "Selected programs installed"
    else
        info "Optional program installation skipped"
    fi
}

readonly MANUAL_HINTS=(
    "qs|https://quickshell.org/docs/guide/install-setup"
    "niri|https://github.com/YaLTeR/niri/wiki/Getting-Started"
    "awww|https://codeberg.org/LGFae/awww"
)

os_field() { [[ -f /etc/os-release ]] && sed -n "s/^$1=//p" /etc/os-release | head -n1 | tr -d '"' || true; }

distro_family()
{
    case " $(os_field ID) $(os_field ID_LIKE) " in
        *" arch "*)                 echo arch ;;
        *" fedora "*|*" rhel "*)    echo fedora ;;
        *" debian "*|*" ubuntu "*)  echo debian ;;
        *)                          echo "" ;;
    esac
}

dependency_packages()
{
    local family="$1" line="$2" field
    IFS='|' read -r _ _ _ arch fedora debian <<< "$line"
    case "$family" in
        arch)   field="$arch" ;;
        fedora) field="$fedora" ;;
        debian) field="$debian" ;;
        *)      field="-" ;;
    esac
    [[ "$field" == "-" ]] && echo "" || echo "$field"
}

AVAILABLE=" "
query_available()
{
    local family="$1"; shift
    case "$family" in
        arch)   AVAILABLE=" $* " ;;
        fedora) AVAILABLE=" $(dnf repoquery -q --qf '%{name}\n' "$@" 2> /dev/null | sort -u | tr '\n' ' ') " ;;
        debian) AVAILABLE=" "; for p in "$@"; do apt-cache show "$p" > /dev/null 2>&1 && AVAILABLE+="$p "; done ;;
    esac
}
line_available()
{
    local copr=false
    for p in $1; do
        [[ "$p" == copr:* ]] && { copr=true; continue; }
        $copr || [[ "$AVAILABLE" == *" $p "* ]] || return 1
    done
}

manual_hint() { local h; for h in "${MANUAL_HINTS[@]}"; do [[ "${h%%|*}" == "$1" ]] && { echo "${h#*|}"; return; }; done; }

aur_helper() { command -v paru > /dev/null && { echo paru; return; }; command -v yay > /dev/null && echo yay; }

ensure_aur_helper()
{
    [[ -n "$(aur_helper)" ]] && return 0
    choose "Some packages are in the AUR only: install an AUR helper?" "paru|recommended" "yay|"
    case "$CHOICE" in
        1) local helper=paru ;;
        2) local helper=yay ;;
        *) return 1 ;;
    esac
    sudo pacman -S --needed base-devel git || return 1
    local tmp; tmp="$(mktemp -d)"
    git clone --depth 1 "https://aur.archlinux.org/$helper-bin.git" "$tmp/$helper" && (cd "$tmp/$helper" && makepkg -si --noconfirm)
    local result=$?
    rm -rf "$tmp"
    [[ $result -eq 0 ]] && ok "$helper installed" || { warn "Could not install $helper"; return 1; }
}

install_packages()
{
    local family="$1"; shift
    [[ $# -gt 0 ]] || return 0
    case "$family" in
        arch)
            local repo=() aur=()
            for p in "$@"; do if pacman -Si "$p" > /dev/null 2>&1; then repo+=("$p"); else aur+=("$p"); fi; done
            [[ ${#repo[@]} -eq 0 ]] || sudo pacman -S --needed "${repo[@]}" || return 1
            if [[ ${#aur[@]} -gt 0 ]]; then
                ensure_aur_helper || { warn "Not installed (AUR): ${aur[*]}"; return 1; }
                "$(aur_helper)" -S --needed "${aur[@]}" || return 1
            fi ;;
        fedora)
            local plain=() coprs=()
            for p in "$@"; do if [[ "$p" == copr:* ]]; then coprs+=("${p#copr:}"); else plain+=("$p"); fi; done
            for c in "${coprs[@]+"${coprs[@]}"}"; do sudo dnf copr enable -y "$c" || return 1; done
            [[ ${#plain[@]} -eq 0 ]] || sudo dnf install -y "${plain[@]}" || return 1 ;;
        debian)
            sudo apt-get update && sudo apt-get install -y "$@" || return 1 ;;
        *) return 1 ;;
    esac
}

tool_available()
{
    if [[ "$1" == qt6-multimedia ]]; then
        python3 "$PACKAGE/scripts/bloodyShell" internal dependencies check "$1"
        return
    fi
    command -v "$1" > /dev/null || return 1
    if [[ "$1" == nmcli && -f "$PACKAGE/scripts/lib/network.py" ]]; then
        python3 "$PACKAGE/scripts/bloodyShell" internal network-auth --check > /dev/null 2>&1
    fi
}

install_dependencies()
{
    local family; family="$(distro_family)"
    local manager=""
    case "$family" in arch) manager=pacman ;; fedora) manager=dnf ;; debian) manager=apt ;; esac
    [[ -n "$family" ]] && info "Distribution: $(os_field PRETTY_NAME) · $manager" \
                       || warn "Unknown distribution: nothing is installed, only checked"

    local missing=() wanted=()
    for line in "${DEPENDENCIES[@]}"; do
        IFS='|' read -r _ tool _ <<< "$line"
        tool_available "$tool" && continue
        missing+=("$line")
        for p in $(dependency_packages "$family" "$line"); do [[ "$p" == copr:* ]] || wanted+=("$p"); done
    done
    [[ ${#wanted[@]} -eq 0 ]] || query_available "$family" "${wanted[@]}"

    local install=() manual=() have=() optional=() optionalLines=()
    for line in "${DEPENDENCIES[@]}"; do
        IFS='|' read -r kind tool feature arch _ <<< "$line"
        if tool_available "$tool"; then have+=("$tool"); continue; fi
        local packages; packages="$(dependency_packages "$family" "$line")"
        [[ -n "$packages" ]] && ! line_available "$packages" && packages=""
        if [[ "$kind" == required ]]; then
            if [[ -n "$packages" ]]; then install+=($packages); else manual+=("$tool|${arch%% *}"); fi
        elif [[ -n "$packages" ]]; then
            optional+=("${packages// /, }|$feature")
            optionalLines+=("$packages")
        fi
    done

    [[ ${#have[@]} -eq 0 ]] || ok "Installed: ${have[*]}"

    if [[ ${#install[@]} -gt 0 ]]; then
        section "Required packages"
        for p in "${install[@]}"; do
            [[ "$p" == copr:* ]] && { printf '    %s+%s Repository  %s\n' "$D" "$R" "${p#copr:}"; continue; }
            printf '    %s•%s %s\n' "$CYN$B" "$R" "$p"
        done
    fi

    local chosen=()
    if [[ ${#optional[@]} -gt 0 ]] && interactive; then
        choose_many "Optional packages" --none "${optional[@]}"
        for i in "${!optional[@]}"; do
            local label="${optional[$i]%%|*}"
            for s in "${SELECTED[@]+"${SELECTED[@]}"}"; do [[ "$s" == "$label" ]] && chosen+=(${optionalLines[$i]}); done
        done
    fi

    local all=("${install[@]+"${install[@]}"}" "${chosen[@]+"${chosen[@]}"}")
    local count=0; for p in "${all[@]+"${all[@]}"}"; do [[ "$p" == copr:* ]] || count=$((count + 1)); done
    if [[ ${#all[@]} -gt 0 ]]; then
        if ! interactive; then
            warn "Not installed (run ./setup install in a terminal): ${all[*]}"
        elif [[ -z "$family" ]]; then
            warn "Install by hand: ${all[*]}"
        elif ask "Install $count packages with $manager? (needs sudo)" y; then
            install_packages "$family" "${all[@]}" && ok "Packages installed" || warn "Some packages were not installed"
        else
            info "Packages skipped"
        fi
    fi

    for entry in "${manual[@]+"${manual[@]}"}"; do
        local hint; hint="$(manual_hint "${entry%%|*}")"
        warn "${entry#*|} is not in the repositories here: install it by hand${hint:+ — $(hl "$hint")}"
    done

    command -v qs > /dev/null || warn "Quickshell is missing: the shell is installed, but won't start until it is"
    install_native_support "$family"
}


install_native_support()
{
    if command -v c++ > /dev/null && command -v wayland-scanner > /dev/null && command -v pkg-config > /dev/null && pkg-config --exists Qt6Quick wayland-client xkbcommon; then return 0; fi
    local family="$1" packages=()
    case "$family" in
        arch) packages=(gcc pkgconf qt6-base qt6-declarative wayland libxkbcommon) ;;
        fedora) packages=(gcc-c++ pkgconf-pkg-config qt6-qtbase-devel qt6-qtdeclarative-devel wayland-devel libxkbcommon-devel) ;;
        debian) packages=(g++ pkg-config qt6-base-dev qt6-base-dev-tools qt6-declarative-dev libwayland-dev libwayland-bin libxkbcommon-dev) ;;
        *) warn "Install C++, Qt 6 Quick, Wayland, and xkbcommon development tools for native keyboard support"; return 0 ;;
    esac
    if interactive && ask "Install development tools for Alt+Tab and the on-screen keyboard? (needs sudo)" y; then
        install_packages "$family" "${packages[@]}" || warn "Native keyboard support could not be prepared"
    else
        warn "Native keyboard build support skipped: ${packages[*]}"
    fi
}

readonly SDDM_THEME="/usr/share/sddm/themes/$NAME"
readonly GREETER_STATE="/var/lib/$NAME"
readonly SDDM_CONF="/etc/sddm.conf.d/zz-$NAME.conf"
readonly SDDM_SYSTEM_CONF="/etc/sddm.conf"

restore_sddm_files()
{
    local theme_backup="$1" config_backup="$2" system_backup="${3:-}"
    sudo rm -rf "$SDDM_THEME"
    [[ -z "$theme_backup" ]] || sudo mv "$theme_backup" "$SDDM_THEME"
    if [[ -n "$config_backup" ]]; then sudo cp -a "$config_backup" "$SDDM_CONF"; else sudo rm -f "$SDDM_CONF"; fi
    [[ -z "$system_backup" ]] || sudo cp --preserve=all "$system_backup" "$SDDM_SYSTEM_CONF"
}

apply_greeter()
{
    local resource="${BLOODYSHELL_RESOURCE_DIR:-$PACKAGE}"
    if [[ ! -d "$resource/dots/sddm" ]]; then
        python3 "$PACKAGE/scripts/bloodyShell" internal resources import greeter --human
        return
    fi
    if ! interactive && ! sudo -n true 2> /dev/null; then warn "Needs sudo in a terminal: login screen skipped"; return 0; fi
    local file line sddm_dependency=""
    for file in Main.qml Widgets.qml Theme.qml metadata.desktop theme.conf niri.kdl; do
        [[ -s "$resource/dots/sddm/$file" ]] || { warn "Missing login-screen file: $file"; return 1; }
    done
    local family; family="$(distro_family)"
    local missing=()
    for line in "${DEPENDENCIES[@]}"; do [[ "$line" != "optional|sddm|"* ]] || sddm_dependency="$line"; done
    if ! command -v sddm > /dev/null || ! command -v sddm-greeter-qt6 > /dev/null; then
        missing+=($(dependency_packages "$family" "$sddm_dependency"))
    fi
    command -v niri > /dev/null || missing+=($(dependency_packages "$family" "${DEPENDENCIES[1]}"))
    if [[ ${#missing[@]} -gt 0 ]]; then
        if [[ -n "$family" ]] && ask "Install ${missing[*]}? (needs sudo)" y; then
            install_packages "$family" "${missing[@]}" || return 1
        else
            warn "Needs ${missing[*]}: login screen skipped"
            return 1
        fi
    fi
    command -v sddm > /dev/null && command -v sddm-greeter-qt6 > /dev/null && command -v niri > /dev/null || { warn "Install SDDM with its Qt 6 greeter and niri first"; return 1; }
    getent passwd sddm > /dev/null || { warn "The SDDM system account is missing: reinstall the sddm package"; return 1; }
    [[ ! -L "$GREETER_STATE" && ( ! -e "$GREETER_STATE" || -d "$GREETER_STATE" ) ]] || { warn "Login-screen storage must be a directory, not a symlink"; return 1; }
    niri validate -c "$resource/dots/sddm/niri.kdl" || return 1
    sudo -v || return 1

    local stage; stage="$(mktemp -d)"
    local theme_backup="" config_backup="" system_backup="" niri_bin
    niri_bin="$(command -v niri)"
    if ! mkdir "$stage/theme" || ! cp -a "$resource/dots/sddm/." "$stage/theme/" || ! ln -s "$GREETER_STATE/theme.conf" "$stage/theme/theme.conf.user"; then
        rm -rf "$stage"; return 1
    fi
    install_native_support "$family"
    if ! mkdir -p "$stage/theme/keyboard" || ! cp -a "$PACKAGE/modules/common/keyboard/." "$stage/theme/keyboard/" ||
       ! python3 "$PACKAGE/scripts/bloodyShell" internal build-virtual-keyboard "$stage/theme/native" > /dev/null; then
        warn "Could not prepare the login-screen keyboard"; rm -rf "$stage"; return 1
    fi
    printf '\nkeyboardSource=keyboard/Keyboard.qml\n' >> "$stage/theme/theme.conf"
    local config_stage="$stage/sddm.conf"
    {
        printf '[General]\nDisplayServer=wayland\n\n[Theme]\nCurrent=%s\n\n[Wayland]\n' "$NAME"
        printf 'CompositorCommand="%s" -c "%s/niri.kdl"\nEnableHiDPI=true\n' "$niri_bin" "$SDDM_THEME"
    } > "$config_stage"
    if [[ -e "$SDDM_SYSTEM_CONF" ]]; then
        if ! sudo cat "$SDDM_SYSTEM_CONF" > "$stage/system-original.conf"; then rm -rf "$stage"; return 1; fi
        awk '
            /^[[:space:]]*\[/ { section=$0; sub(/^[[:space:]]*\[/,"",section); sub(/\].*$/,"",section) }
            section == "General" && /^[[:space:]]*DisplayServer[[:space:]]*=/ { next }
            section == "Theme" && /^[[:space:]]*Current[[:space:]]*=/ { next }
            section == "Wayland" && /^[[:space:]]*(CompositorCommand|EnableHiDPI)[[:space:]]*=/ { next }
            { print }
        ' "$stage/system-original.conf" > "$stage/system.conf"
    fi
    if [[ -e "$SDDM_THEME" || -L "$SDDM_THEME" ]]; then
        theme_backup="$SDDM_THEME.bak-$STAMP-$RANDOM"
        sudo mv "$SDDM_THEME" "$theme_backup" || { rm -rf "$stage"; return 1; }
    fi
    if [[ -e "$SDDM_CONF" ]]; then
        config_backup="$SDDM_CONF.bak-$STAMP-$RANDOM"
        if ! sudo cp -a "$SDDM_CONF" "$config_backup"; then
            [[ -z "$theme_backup" ]] || sudo mv "$theme_backup" "$SDDM_THEME"
            rm -rf "$stage"; return 1
        fi
    fi
    if [[ -f "$stage/system.conf" ]] && ! cmp -s "$stage/system-original.conf" "$stage/system.conf"; then
        system_backup="$SDDM_SYSTEM_CONF.bak-$STAMP-$RANDOM"
        if ! sudo cp -L --preserve=all "$SDDM_SYSTEM_CONF" "$system_backup"; then
            restore_sddm_files "$theme_backup" "$config_backup"
            rm -rf "$stage"; return 1
        fi
    fi
    if ! {
        sudo mkdir -p "$SDDM_THEME" "$(dirname "$SDDM_CONF")" &&
        sudo cp -a "$stage/theme/." "$SDDM_THEME/" &&
        sudo chown -R root:root "$SDDM_THEME" &&
        sudo chmod -R a+rX,go-w "$SDDM_THEME" &&
        sudo install -d -m 2755 -o "$USER" -g sddm "$GREETER_STATE" &&
        python3 "$PACKAGE/scripts/bloodyShell" internal greeter-settings "$CONFIG_HOME/$NAME/settings.json" "$GREETER_STATE" &&
        sudo install -m 644 "$config_stage" "$SDDM_CONF" &&
        { [[ -z "$system_backup" ]] || sudo tee "$SDDM_SYSTEM_CONF" < "$stage/system.conf" > /dev/null; };
    }; then
        restore_sddm_files "$theme_backup" "$config_backup" "$system_backup"
        rm -rf "$stage"; return 1
    fi
    rm -rf "$stage"
    ok "SDDM theme → $(hl "$SDDM_THEME")"
    ok "Wayland login screen uses its own niri configuration"
    [[ -z "$theme_backup" ]] || info "Previous theme → $(hl "$theme_backup")"
    [[ -z "$config_backup" ]] || info "Previous configuration → $(hl "$config_backup")"
    [[ -z "$system_backup" ]] || info "Managed login options moved to $SDDM_CONF (backup: $system_backup)"

    local current previous
    current="$(systemctl show --property=Id --value display-manager.service 2>/dev/null || true)"
    if [[ "$current" == sddm.service ]] && systemctl is-enabled --quiet sddm.service 2> /dev/null; then
        ok "SDDM is already enabled; the running session is unchanged"
        return
    fi
    previous="$current"
    [[ "$previous" =~ ^[A-Za-z0-9@_.-]+[.]service$ && "$previous" != sddm.service && "$previous" != display-manager.service ]] || previous=""
    if ask "Use SDDM from the next boot${previous:+ (replaces $previous)}?" y; then
        if [[ -n "$previous" ]] && ! sudo systemctl disable "$previous"; then
            restore_sddm_files "$theme_backup" "$config_backup" "$system_backup"; return 1
        fi
        if ! sudo systemctl enable sddm.service; then
            sudo systemctl disable sddm.service || true
            if [[ -n "$previous" ]] && ! sudo systemctl enable "$previous"; then
                warn "Could not re-enable $previous; restore it with sudo systemctl enable $previous"
            fi
            restore_sddm_files "$theme_backup" "$config_backup" "$system_backup"
            warn "Could not enable SDDM; theme configuration was rolled back"
            return 1
        fi
        ok "SDDM will be used after a reboot"
    else
        info "Theme installed; login manager unchanged"
    fi
}

latest_tag()
{
    local beta="$1" json
    json="$(curl -fsSL --max-time 15 -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$REPO/releases?per_page=30")" \
        || return 1

    if command -v jq > /dev/null; then
        jq -r --argjson beta "$beta" '[.[] | select(.draft | not) | select($beta or (.prerelease | not))][0].tag_name // empty' <<< "$json"
        return
    fi

    tr -d '\n' <<< "$json" \
        | grep -o '"tag_name": *"[^"]*"[^{}]*"draft": *[a-z]*, *"prerelease": *[a-z]*' \
        | while IFS= read -r entry; do
            local tag draft pre
            tag="$(sed -E 's/.*"tag_name": *"([^"]*)".*/\1/' <<< "$entry")"
            draft="$(sed -E 's/.*"draft": *([a-z]*).*/\1/' <<< "$entry")"
            pre="$(sed -E 's/.*"prerelease": *([a-z]*).*/\1/' <<< "$entry")"
            [[ "$draft" == "false" ]] || continue
            [[ "$beta" == "true" || "$pre" == "false" ]] || continue
            echo "$tag"
            break
        done
}

cmd_install()
{
    [[ $EUID -ne 0 ]] || die "Run setup as your normal user; it requests sudo only when needed"
    lock_installation
    section "Installation plan"
    detail "Shell" "$(hl "$TARGET")"
    detail "Command" "$(hl "$BIN_HOME/$NAME")"
    detail "Backups" "$(hl "$BACKUP_ROOT/$STAMP")"
    info "Choose optional programs, app configs and the login screen during setup"
    info "Existing shell and replaced files are backed up; your shell settings are kept"
    if interactive && ! ask "Continue with installation?" y; then info "Installation cancelled"; return 0; fi
    steps 7

    step "Dependencies"
    install_dependencies

    step "Optional programs"
    install_applications

    step "Compositor configuration"
    python3 "$PACKAGE/scripts/bloodyShell" internal resources import compositor --human || die "Could not import the required compositor configuration"

    step "Installing the shell"
    info "Wallpapers are optional: import them from Settings → Updates when wanted"
    apply_shell

    step "App configs"
    apply_configs

    step "Login screen"
    if ask "Set up the login screen in the shell's style (SDDM, needs sudo)?" n; then apply_greeter; else info "Login screen skipped: run ./setup sddm any time"; fi

    step "Checking installation"
    local missing=() kind tool line
    for line in "${DEPENDENCIES[@]}"; do
        IFS='|' read -r kind tool _ <<< "$line"
        if [[ "$kind" == required ]] && ! tool_available "$tool"; then missing+=("$tool"); fi
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        warn "Missing required tools: ${missing[*]}"
        warn "Install these before starting; bloodyShell doctor shows the details"
        finish "Files installed · dependencies need attention"
        return 0
    fi
    restart_shell

    finish "Installation complete"
}

cmd_update()
{
    lock_installation
    local beta=false tag="" force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --beta)  beta=true ;;
            --tag)   [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || die "--tag needs a release tag"; tag="$2"; shift ;;
            --force) force=true ;;
            *) die "Unknown option: $1" ;;
        esac
        shift
    done

    banner
    STATUS_ENABLED=true
    status "running"
    command -v curl > /dev/null && command -v python3 > /dev/null || die "Updating needs curl and Python 3"
    steps 3

    step "Looking for a release"
    if [[ -z "$tag" ]]; then
        tag="$(latest_tag "$beta")" || die "GitHub is unreachable"
        [[ -n "$tag" ]] || die "No releases yet"
    fi
    local current; current="$(installed_version)"
    if ! $force && ! version_newer "$tag" "$current"; then
        ok "Up to date: installed $current, latest ${tag#v}"
        if [[ -f "$TARGET/scripts/bloodyShell" && -f "$TARGET/scripts/lib/management.py" ]]; then install_command; fi
        status "done $current"
        return 0
    fi
    ok "${tag#v} is available (installed $current)"

    UPDATE_TMP="$(mktemp -d)"
    trap 'rm -rf -- "$UPDATE_TMP"' EXIT
    local tmp="$UPDATE_TMP"

    step "Downloading ${tag#v}"
    curl -fsSL --retry 2 --max-time 120 -o "$tmp/package.tar.gz" "https://github.com/$REPO/archive/refs/tags/$tag.tar.gz" \
        || die "Could not download $tag"
    mkdir "$tmp/package"
    python3 "$PACKAGE/scripts/bloodyShell" internal extract-release "$tmp/package.tar.gz" "$tmp/package" || die "Package $tag is damaged"

    [[ -f "$tmp/package/setup" && -f "$tmp/package/shell.qml" && -f "$tmp/package/version" ]] || die "Package $tag has no shell in it"
    local packaged; packaged="$(tr -d '[:space:]' < "$tmp/package/version")"
    [[ "$packaged" == "${tag#v}" ]] || die "Package version ($packaged) doesn't match tag $tag"
    ok "Package checked"

    step "Installing ${tag#v}"
    apply_shell "$tmp/package"
    status "done $(installed_version)"
    restart_shell
    finish "Update complete"
}

cmd_sddm()
{
    apply_greeter
    return 0
}

cmd_configs()
{
    apply_configs "$@"
    $BACKED_UP && info "Backups → $(hl "$BACKUP_ROOT/$STAMP")"
    return 0
}

cmd_doctor()
{
    command -v python3 > /dev/null || die "Doctor requires Python 3"
    if [[ "${1:-}" != --json ]]; then banner; section "Diagnostics"; fi
    python3 "$PACKAGE/scripts/bloodyShell" internal doctor "$@"
}

cmd_uninstall()
{
    # Replace Bash before removing the installed script that Bash is reading.
    exec python3 "$PACKAGE/scripts/bloodyShell" internal uninstall "$@"
}

cmd_cli()
{
    python3 "$PACKAGE/scripts/bloodyShell" internal resources import cli --human
}

usage()
{
    banner
    section "Commands"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup"                  "$R" "menu"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup install"          "$R" "install dependencies, the shell and app configs, start it"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup uninstall"        "$R" "preview removal; --apply asks about SDDM and shell settings"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup update [--beta]"  "$R" "download and install the latest release"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup doctor [--json]"  "$R" "check dependencies and configuration"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup configs [names]"  "$R" "re-apply app configs (kitty, fastfetch, GTK…)"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup cli"              "$R" "refresh the CLI and PATH without reinstalling the shell"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup sddm"           "$R" "login screen in the shell's style (SDDM, sudo)"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup help"             "$R" "show commands and options"
    section "Update options"
    printf '    %-22s %s\n' "--beta"        "update channel: include pre-releases"
    printf '    %-22s %s\n' "--tag vX.Y.Z"  "install exactly this release"
    printf '    %-22s %s\n\n' "--force"     "reinstall even if up to date"
    info "After installation: bloodyShell help · bloodyShell settings · bloodyShell doctor"
    printf '\n'
}

menu()
{
    banner

    local items=() actions=()
    items+=("Install|Set up the shell, dependencies and app configs"); actions+=(install)
    items+=("Update|Download and install a release");               actions+=(update)
    items+=("Doctor|Check dependencies and configuration");         actions+=(doctor)
    items+=("Configs|Apply app configuration files"); actions+=(configs)
    items+=("SDDM|Configure the login screen · administrator access");   actions+=(sddm)
    items+=("Uninstall|Remove the shell; optionally remove SDDM theme and shell settings"); actions+=(uninstall)
    items+=("Help|View commands and options");                         actions+=(help)

    choose "Choose an action" "${items[@]}"
    [[ "$CHOICE" -eq 0 ]] && return 0

    case "${actions[$((CHOICE - 1))]}" in
        install) cmd_install ;;
        update)
            choose "Update channel" "Stable|releases only" "Beta|also pre-releases: newer, less tested"
            case "$CHOICE" in
                1) cmd_update ;;
                2) cmd_update --beta ;;
                *) return 0 ;;
            esac ;;
        doctor)  cmd_doctor ;;
        configs) cmd_configs ;;
        sddm) cmd_sddm ;;
        uninstall)
            python3 "$PACKAGE/scripts/bloodyShell" internal uninstall
            if ask "Stop and uninstall bloodyShell?" n; then
                cmd_uninstall --apply
            fi ;;
        help)    usage ;;
    esac
}

main()
{
    if interactive; then printf '\033[2J\033[H'; fi

    local command="${1:-}"
    [[ $# -gt 0 ]] && shift

    local args=("$@")
    for arg in "${args[@]}"; do
        case "$arg" in
            -y|--yes) die "Unknown option: $arg" ;;
        esac
    done

    case "$command" in
        install|sddm|cli|help)
            [[ ${#args[@]} -eq 0 ]] || die "Unexpected argument for $command: ${args[0]}"
            ;;
    esac

    case "$command" in
        install) banner; cmd_install ;;
        uninstall) cmd_uninstall "${args[@]+"${args[@]}"}" ;;
        update)  cmd_update  "${args[@]+"${args[@]}"}" ;;
        doctor)  cmd_doctor "${args[@]+"${args[@]}"}" ;;
        configs) banner; cmd_configs "${args[@]+"${args[@]}"}" ;;
        cli) cmd_cli ;;
        sddm) banner; cmd_sddm ;;
        "")      if interactive; then menu; else usage; fi ;;
        help) usage ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"
