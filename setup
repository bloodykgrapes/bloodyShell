#!/usr/bin/env bash

set -euo pipefail

readonly REPO="bloodykgrapes/bloodyShell"
readonly NAME="bloodyShell"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly TARGET="$CONFIG_HOME/quickshell/$NAME"
readonly BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
readonly BACKUP_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/$NAME/backups"
readonly STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$NAME"
readonly STATUS_FILE="${BLOODYSHELL_STATUS:-$STATE_DIR/update.status}"
readonly STAMP="$(date +%Y-%m-%d_%H-%M-%S)-$$"
readonly PACKAGE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


BACKED_UP=false

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    B=$'\e[1m' D=$'\e[2m' R=$'\e[0m'
    RED=$'\e[31m' GRN=$'\e[32m' YLW=$'\e[33m' BLU=$'\e[34m' MAG=$'\e[35m' CYN=$'\e[36m'
else
    B="" D="" R="" RED="" GRN="" YLW="" BLU="" MAG="" CYN=""
fi
interactive() { [[ -t 0 && -t 1 ]]; }
use_gum() { interactive && command -v gum > /dev/null; }

gum_choose()
{
    gum choose \
        --cursor "› " \
        --cursor.foreground 0 --cursor.background 6 --cursor.bold \
        --selected.foreground 0 --selected.background 6 --selected.bold \
        --header.foreground 6 --header.bold \
        --cursor-prefix "[ ] " --selected-prefix "[✓] " --unselected-prefix "[ ] " \
        --padding "1 2" "$@"
}

pretty() { printf '%s' "${1/#$HOME/\~}"; }
hl()     { printf '%s%s%s' "$CYN" "$(pretty "$1")" "$R"; }

message() { printf '  %s%s%-5s%s  %s\n' "$1" "$B" "$2" "$R" "$3"; }
info() { message "$CYN" "INFO" "$*"; }
ok()   { message "$GRN" "DONE" "$*"; }
warn() { message "$YLW" "NOTE" "$*" >&2; }
die()  { message "$RED" "ERROR" "$*" >&2; status "failed $*"; exit 1; }

rule()
{
    local width="${COLUMNS:-80}"
    [[ "$width" =~ ^[0-9]+$ ]] || width=80
    width=$((width > 76 ? 72 : width > 8 ? width - 4 : 4))
    printf '  %s' "$D"
    printf '─%.0s' $(seq "$width")
    printf '%s\n' "$R"
}

section() { printf '\n  %s%s%s%s\n' "$CYN" "$B" "$1" "$R"; rule; }
detail() { printf '    %s%-10s%s %s\n' "$D" "$1" "$R" "$2"; }

pad_choices()
{
    local -n rows="$1"
    local width=0 row i
    for row in "${rows[@]}"; do (( ${#row} > width )) && width=${#row}; done
    for i in "${!rows[@]}"; do printf -v 'rows[i]' ' %-*s ' "$width" "${rows[$i]}"; done
    return 0
}

STEP=0 STEPS=0
steps() { STEP=0; STEPS="$1"; }
step()
{
    local i
    STEP=$((STEP + 1))
    printf '\n  %s%s%02d / %02d%s  %s%s%s\n' "$CYN" "$B" "$STEP" "$STEPS" "$R" "$B" "$*" "$R"
    printf '  '
    for ((i=1; i<=STEPS; i++)); do
        if (( i <= STEP )); then printf '%s━━━━' "$CYN"; else printf '%s────' "$D"; fi
        (( i < STEPS )) && printf ' '
    done
    printf '%s\n\n' "$R"
    status "step $STEP/$STEPS $*"
}

package_version() { [[ -f "$PACKAGE/version" ]] && tr -d '[:space:]' < "$PACKAGE/version" || echo "?"; }
installed_version() { [[ -f "$TARGET/version" ]] && tr -d '[:space:]' < "$TARGET/version" || echo "0.0.0"; }

banner()
{
    local installed="Not installed"
    [[ -f "$TARGET/version" ]] && installed="$(installed_version)"
    printf '\n  %s%s◆  %s%s  %sSetup%s\n' "$CYN" "$B" "$NAME" "$R" "$D" "$R"
    rule
    detail "Package" "$(package_version)"
    detail "Installed" "$installed"
    printf '\n'
}

finish()
{
    section "$1"
    detail "Version" "$(installed_version)"
    detail "Shell" "$(hl "$TARGET")"
    if $BACKED_UP; then detail "Backup" "$(hl "$BACKUP_ROOT/$STAMP")"; fi
    detail "Command" "$(hl "$BIN_HOME/$NAME")"
    detail "Niri" "$(hl "$CONFIG_HOME/niri") · required; user files kept"
    detail "Start" "bloodyShell"
    detail "Settings" "bloodyShell settings"
    detail "Check" "bloodyShell doctor"
    detail "Update" "bloodyShell update"
    info "Open a new terminal to use the command. Log out and back in for niri keybinds."
    printf '\n'
}

ask()
{
    interactive || return 1

    local default="${2:-y}" hint answer
    if use_gum; then
        local initial="No"
        [[ "$default" == "y" ]] && initial="Yes"
        if answer="$(gum_choose --header "$1" --selected "$initial" -- Yes No)"; then
            [[ "$answer" == "Yes" ]]
            return
        else
            local result=$?
            [[ $result -eq 130 ]] && exit 130
            return 1
        fi
    fi
    [[ "$default" == "y" ]] && hint="Y/n" || hint="y/N"
    while true; do
        printf '  %s%s?%s %s%s%s %s[%s]%s\n' "$BLU" "$B" "$R" "$B" "$1" "$R" "$D" "$hint" "$R"
        read -r -p $'\n'"  ${BLU}${B}›${R} " answer || return 1
        answer="${answer,,}"
        [[ -z "$answer" ]] && answer="$default"
        case "$answer" in
            y|yes) return 0 ;;
            n|no)  return 1 ;;
            *)     warn "Answer y or n" ;;
        esac
    done
}

CHOICE=0
choose()
{
    local title="$1"; shift
    local items=("$@") n="$#"

    CHOICE=0
    if use_gum; then
        local display=() item label about chosen width=0
        for item in "${items[@]}"; do
            label="${item%%|*}"
            (( ${#label} > width )) && width=${#label}
        done
        for item in "${items[@]}"; do
            label="${item%%|*}"
            about=""
            [[ "$item" == *"|"* ]] && about="${item#*|}"
            display+=("$(printf '%-*s  %s' "$width" "$label" "$about")")
        done
        display+=("Quit")
        pad_choices display
        if chosen="$(gum_choose --header "$title" -- "${display[@]}")"; then
            for i in "${!display[@]}"; do
                [[ "$chosen" == "${display[$i]}" ]] && { (( i < n )) && CHOICE=$((i + 1)); break; }
            done
        fi
        return 0
    fi

    section "$title"
    for i in $(seq "$n"); do
        local item="${items[$((i - 1))]}"
        local label="${item%%|*}" about=""
        [[ "$item" == *"|"* ]] && about="${item#*|}"
        printf '    %s%d)%s %-14s %s%s%s\n' "$CYN$B" "$i" "$R" "$label" "$D" "$about" "$R"
    done
    printf '    %s0)%s %sQuit%s\n' "$D" "$R" "$D" "$R"

    local answer
    while true; do
        read -r -p $'\n'"  ${BLU}${B}›${R} " answer || { CHOICE=0; return; }
        if [[ "$answer" =~ ^[0-9]+$ ]] && (( answer >= 0 && answer <= n )); then
            CHOICE="$answer"
            return
        fi
        warn "Enter a number from 0 to $n"
    done
}

SELECTED=()
choose_many()
{
    local title="$1"; shift
    local defaults=1
    if [[ "${1:-}" == --none ]]; then defaults=0; shift; fi
    local items=("$@") n="$#" marks=() width=12
    for item in "${items[@]}"; do marks+=("$defaults"); local l="${item%%|*}"; (( ${#l} > width )) && width=${#l}; done

    if use_gum; then
        local display=() item label about chosen line
        SELECTED=()
        for item in "${items[@]}"; do
            label="${item%%|*}"
            about=""
            [[ "$item" == *"|"* ]] && about="${item#*|}"
            display+=("$(printf '%-*s  %s' "$width" "$label" "$about")")
        done
        pad_choices display
        local initial=""
        [[ "$defaults" == 0 ]] || initial='*'
        if chosen="$(gum_choose --no-limit --ordered --selected "$initial" --header "$title · X toggle · Enter continue" -- "${display[@]}")"; then
            while IFS= read -r line; do
                for i in "${!display[@]}"; do
                    [[ "$line" == "${display[$i]}" ]] && { SELECTED+=("${items[$i]%%|*}"); break; }
                done
            done <<< "$chosen"
        else
            local result=$?
            [[ $result -eq 130 ]] && exit 130
        fi
        return 0
    fi

    if interactive; then
        local answer
        while true; do
            section "$title"
            printf '  %snumbers toggle · a all · n none · Enter continue%s\n\n' "$D" "$R"
            for i in $(seq "$n"); do
                local item="${items[$((i - 1))]}"
                local label="${item%%|*}" about="" box
                [[ "$item" == *"|"* ]] && about="${item#*|}"
                if [[ "${marks[$((i - 1))]}" == 1 ]]; then box="${GRN}${B}[✓]${R}"; else box="${D}[ ]${R}"; fi
                printf '    %s %s%2d)%s %-*s  %s%s%s\n' "$box" "$CYN$B" "$i" "$R" "$width" "$label" "$D" "$about" "$R"
            done

            read -r -p $'\n'"  ${BLU}${B}›${R} " answer || break
            [[ -z "$answer" ]] && break
            case "${answer,,}" in
                a) for i in "${!marks[@]}"; do marks[i]=1; done; continue ;;
                n) for i in "${!marks[@]}"; do marks[i]=0; done; continue ;;
            esac
            for word in ${answer//,/ }; do
                if [[ "$word" =~ ^[0-9]+$ ]] && (( word >= 1 && word <= n )); then
                    marks[word - 1]=$(( 1 - marks[word - 1] ))
                else
                    warn "No item $word"
                fi
            done
        done
    fi

    SELECTED=()
    for i in $(seq "$n"); do
        [[ "${marks[$((i - 1))]}" == 1 ]] && SELECTED+=("${items[$((i - 1))]%%|*}")
    done
    return 0
}

STATUS_ENABLED=false
status() { if $STATUS_ENABLED; then mkdir -p "$(dirname "$STATUS_FILE")"; printf '%s\n' "$*" > "$STATUS_FILE"; fi; }

backup()
{
    mkdir -p "$BACKUP_ROOT/$STAMP" || return 1
    [[ ! -e "$BACKUP_ROOT/$STAMP/$2" && ! -L "$BACKUP_ROOT/$STAMP/$2" ]] || return 1
    mv -- "$1" "$BACKUP_ROOT/$STAMP/$2" || return 1
    BACKED_UP=true
}

lock_installation()
{
    local state="${XDG_STATE_HOME:-$HOME/.local/state}/$NAME"
    mkdir -p -m 700 "$state"
    exec {BLOODYSHELL_OPERATION_FD}> "$state/operation.lock"
    flock -n "$BLOODYSHELL_OPERATION_FD" || die "Another installation, update or uninstall is in progress"
}

unlock_installation()
{
    if [[ -n "${BLOODYSHELL_OPERATION_FD:-}" ]]; then
        flock -u "$BLOODYSHELL_OPERATION_FD"
        exec {BLOODYSHELL_OPERATION_FD}>&-
    fi
}

version_newer()
{
    local a="${1#v}" b="${2#v}"
    [[ "$a" == "$b" ]] && return 1

    local a_core="${a%%-*}" b_core="${b%%-*}" a_pre="" b_pre=""
    [[ "$a" == *-* ]] && a_pre="${a#*-}"
    [[ "$b" == *-* ]] && b_pre="${b#*-}"

    if [[ "$a_core" != "$b_core" ]]; then
        [[ "$(printf '%s\n%s\n' "$a_core" "$b_core" | sort -V | tail -n1)" == "$a_core" ]]
        return
    fi
    [[ -z "$a_pre" ]] && return 0
    [[ -z "$b_pre" ]] && return 1
    [[ "$(printf '%s\n%s\n' "$a_pre" "$b_pre" | sort -V | tail -n1)" == "$a_pre" ]]
}

restart_shell()
{
    # A daemonized shell must not inherit a held installer lock.
    unlock_installation
    [[ -n "${WAYLAND_DISPLAY:-}" ]] || { warn "No Wayland session: run bloodyShell after logging into niri"; return 0; }
    if python3 "$BIN_HOME/$NAME" restart; then
        ok "Shell started"
    else
        warn "Shell could not start: use bloodyShell doctor and bloodyShell logs"
    fi
}

install_command()
{
    python3 "$TARGET/scripts/bloodyShell" internal install-command "$TARGET/scripts/bloodyShell" "$BIN_HOME" "$BACKUP_ROOT/$STAMP/launcher" "$@" > /dev/null \
        || { warn "Could not install the bloodyShell command"; return 1; }
    [[ ! -d "$BACKUP_ROOT/$STAMP/launcher" ]] || BACKED_UP=true
    ok "Command → $(hl "$BIN_HOME/$NAME")"
    if [[ ":$PATH:" != *":$BIN_HOME:"* ]]; then export PATH="$BIN_HOME:$PATH"; fi
    ok "PATH configured for your shells and user services"
}

apply_shell()
{
    local package="${1:-$PACKAGE}"
    [[ -f "$package/shell.qml" && -f "$package/version" ]] || die "No shell in $(pretty "$package") (shell.qml, version)"
    command -v python3 > /dev/null || die "Python 3 is required to install the shell command"

    (
        stage=""; installed=false; backed=false; committed=false
        cleanup_installation()
        {
            local result=$?
            trap - EXIT INT TERM
            if ! $committed; then
                if $installed; then rm -rf -- "$TARGET"; fi
                if $backed; then mv -- "$BACKUP_ROOT/$STAMP/shell" "$TARGET"; fi
            fi
            [[ -z "$stage" || ! -d "$stage" ]] || rm -rf -- "$stage"
            exit "$result"
        }
        trap cleanup_installation EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        if [[ "$package" != "$TARGET" ]]; then
            mkdir -p "$CONFIG_HOME/quickshell" || exit 1
            stage="$(mktemp -d "$CONFIG_HOME/quickshell/.$NAME.new.XXXXXX")" || exit 1
            python3 "$PACKAGE/scripts/bloodyShell" internal stage-runtime "$package" "$stage" "$BIN_HOME" || exit 1
            if [[ -e "$TARGET" || -L "$TARGET" ]]; then
                backup "$TARGET" shell || exit 1
                backed=true
                info "Previous version → $(hl "$BACKUP_ROOT/$STAMP/shell")"
            fi
            mv -- "$stage" "$TARGET" || exit 1
            stage=""; installed=true
        fi
        chmod +x "$TARGET/setup" || exit 1
        install_command || exit 1
        committed=true
    ) || die "Installation failed; previous shell and settings were kept"
    [[ ! -d "$BACKUP_ROOT/$STAMP" ]] || BACKED_UP=true
    if [[ ":$PATH:" != *":$BIN_HOME:"* ]]; then export PATH="$BIN_HOME:$PATH"; fi
    if [[ -f "$TARGET/scripts/lib/processes.py" ]]; then
        python3 "$TARGET/scripts/bloodyShell" internal build-keyboard-monitor > /dev/null || warn "Alt+Tab modifier support needs Qt 6 development tools; see the installation guide in the source repository"
    fi
    ok "$NAME $(tr -d '[:space:]' < "$TARGET/version") → $(hl "$TARGET")"
}

apply_configs()
{
    local programs=("$@")
    if [[ ${#programs[@]} -eq 0 ]]; then
        local items=() available=() names program
        names="$(python3 "$PACKAGE/scripts/bloodyShell" internal resources programs)" || return 1
        [[ -z "$names" ]] || mapfile -t available <<< "$names"
        for program in "${available[@]}"; do
            if [[ -e "$CONFIG_HOME/$program" ]]; then items+=("$program|replaces $(pretty "$CONFIG_HOME/$program") (backed up)")
            else items+=("$program|new $(pretty "$CONFIG_HOME/$program")"); fi
        done
        [[ ${#items[@]} -gt 0 ]] || return 0

        choose_many "App configs" "${items[@]}"
        programs=("${SELECTED[@]+"${SELECTED[@]}"}")
        [[ ${#programs[@]} -gt 0 ]] || { info "App configs skipped"; return 0; }
    fi

    ask "Import configs for ${programs[*]}? Existing files are backed up." y || { info "App configs skipped"; return 0; }

    for program in "${programs[@]}"; do
        [[ "$program" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "Invalid config name: $program"
        python3 "$PACKAGE/scripts/bloodyShell" internal resources import "dots/$program" --human || return 1
    done
}


