#!/usr/bin/env bash

set -euo pipefail

readonly NAME="bloodyShell"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
readonly BACKUP_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/$NAME/backups"
readonly STAMP="$(date +%Y-%m-%d_%H-%M-%S)-$$"
readonly PACKAGE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


command -v python3 > /dev/null || { printf "Python 3 is required to run setup.\n" >&2; exit 1; }
source "$PACKAGE/scripts/lib/system.sh"

cmd_install()
{
    [[ $EUID -ne 0 ]] || die "Run setup as your normal user"
    exec python3 "$PACKAGE/scripts/bloodyShell" internal setup wizard
}

apply_shell()
{
    python3 "$PACKAGE/scripts/bloodyShell" internal install-runtime "${1:-$PACKAGE}" "$BIN_HOME" "$BACKUP_ROOT/$STAMP"
}

cmd_install_stage()
{
    [[ $EUID -ne 0 ]] || die "Run setup as your normal user"
    [[ $# -eq 2 && "$1" =~ ^[0-5]$ ]] || die "Invalid installation stage"
    local stage="$1" plan="$2" family="" backup="" option key value data
    local packages=() appearance=() options=()
    data="$(python3 "$PACKAGE/scripts/bloodyShell" internal setup worker-plan "$plan")" || die "Invalid installation plan"
    while IFS=$'\t' read -r key value; do
        case "$key" in
            family) family="$value" ;;
            backup) backup="$value" ;;
            packages) packages+=("$value") ;;
            appearance_packages) appearance+=("$value") ;;
            selected) options+=("$value") ;;
        esac
    done <<< "$data"
    export BLOODYSHELL_SETUP_BATCH=1
    export BLOODYSHELL_SETUP_BACKUP="$backup"
    # The wizard owns authentication; worker output must never hide another prompt.
    sudo() { command sudo -n "$@"; }
    ask() { return 0; }

    case "$stage" in
        0) python3 "$PACKAGE/scripts/bloodyShell" internal setup check "$plan" ;;
        1)
            case "$family" in
                arch) sudo pacman -Syu --noconfirm ;;
                fedora) sudo dnf upgrade -y ;;
                debian) apt_command update; apt_command upgrade -y ;;
            esac
            install_packages "$family" "${packages[@]}" || die "Package installation failed"
            ;;
        2)
            install_packages "$family" "${appearance[@]}" || die "Appearance packages could not be installed"
            python3 "$PACKAGE/scripts/bloodyShell" internal setup theme "$plan"
            ;;
        3)
            for option in "${options[@]}"; do
                [[ "$option" != login ]] || apply_greeter
            done
            python3 "$PACKAGE/scripts/bloodyShell" internal setup theme-settings "$plan"
            python3 "$PACKAGE/scripts/bloodyShell" internal setup login-shell "$plan"
            ;;
        4)
            python3 "$PACKAGE/scripts/bloodyShell" internal setup configs "$plan"
            apply_shell
            if [[ "$backup" == false ]]; then
                rm -rf -- "$BACKUP_ROOT/$STAMP/shell" "$BACKUP_ROOT/$STAMP/launcher"
                rmdir -- "$BACKUP_ROOT/$STAMP" 2> /dev/null || true
            fi
            ;;
        5) python3 "$PACKAGE/scripts/bloodyShell" internal setup verify "$plan" ;;
    esac
}

cmd_update()
{
    python3 "$PACKAGE/scripts/bloodyShell" update "$@"
}

cmd_sddm()
{
    python3 "$PACKAGE/scripts/bloodyShell" sddm
}

cmd_configs()
{
    python3 "$PACKAGE/scripts/bloodyShell" configs "$@"
}

cmd_doctor()
{
    python3 "$PACKAGE/scripts/bloodyShell" doctor "$@"
}

cmd_uninstall()
{
    exec python3 "$PACKAGE/scripts/bloodyShell" internal uninstall "$@"
}

cmd_cli()
{
    python3 "$PACKAGE/scripts/bloodyShell" internal resources import cli --human
}

usage()
{
    printf '\n  %s%sbloodyShell Setup%s\n' "$CYN" "$B" "$R"
    section "Commands"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup"                  "$R" "repository installation wizard"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup install"          "$R" "install dependencies, the shell and app configs, start it"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup uninstall"        "$R" "confirm removal and choose what to delete"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup update [--beta]"  "$R" "download and install the latest release"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup doctor [--json]"  "$R" "check dependencies and configuration"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup configs [names]"  "$R" "re-apply app configs (kitty, fastfetch, GTK…)"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup cli"              "$R" "refresh the CLI and PATH without reinstalling the shell"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup sddm"           "$R" "login screen in the shell's style (SDDM, sudo)"
    printf '    %s%-26s%s %s\n' "$CYN" "./setup help"             "$R" "show commands and options"
    section "Update options"
    printf '    %-22s %s\n' "--beta"        "update channel: include pre-releases"
    printf '    %-22s %s\n' "--tag vX.Y.Z"  "install exactly this release"
    printf '    %-22s %s\n\n' "--force"     "reinstall even if up to date"
    info "After installation: bloodyShell help · bloodyShell settings · bloodyShell doctor"
    printf '\n'
}

main()
{
    if interactive; then printf '\033[2J\033[H'; fi

    local command="${1:-}"
    [[ $# -gt 0 ]] && shift

    local args=("$@")
    for arg in "${args[@]}"; do
        case "$arg" in
            -y|--yes) die "Unknown option: $arg" ;;
        esac
    done

    case "$command" in
        install|sddm|cli|help)
            [[ ${#args[@]} -eq 0 ]] || die "Unexpected argument for $command: ${args[0]}"
            ;;
    esac

    case "$command" in
        install) cmd_install ;;
        install-stage) cmd_install_stage "${args[@]}" ;;
        uninstall) cmd_uninstall "${args[@]+"${args[@]}"}" ;;
        update)  cmd_update  "${args[@]+"${args[@]}"}" ;;
        doctor)  cmd_doctor "${args[@]+"${args[@]}"}" ;;
        configs) cmd_configs "${args[@]+"${args[@]}"}" ;;
        cli) cmd_cli ;;
        sddm) cmd_sddm ;;
        "")
            if interactive; then
                cmd_install
            else usage; fi
            ;;
        help) usage ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"
